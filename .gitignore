.DS_Store

# PlatformIO — Build-Cache und generierte VS-Code-Configs (alle Projekte)
firmware/projects/*/.pio/
firmware/projects/*/.vscode/.browse.c_cpp.db*
firmware/projects/*/.vscode/c_cpp_properties.json
firmware/projects/*/.vscode/launch.json
firmware/projects/*/.vscode/ipch

# Secrets — nicht in Git (platformio.secrets.ini.example bleibt getrackt)
firmware/projects/*/platformio.secrets.ini
firmware/projects/*/include/secret.h

# MachineNode — CMake Build-Artefakte
firmware/projects/MachineNode/build/

# Smart Terminal — lokale Dev-Config (printers.example.json bleibt getrackt)
software/SmartTerminal_3D_Print/config/printers.dev.json
software/SmartTerminal_3D_Print/config/terminal.env
