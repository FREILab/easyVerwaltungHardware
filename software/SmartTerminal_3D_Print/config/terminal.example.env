# Gerätespezifische Config — wird beim First-Boot über die Touch-UI eingegeben.
# Shared Secrets (API_TOKEN, API_URL, OTA_MANIFEST_URL) sind bereits im SD-Image
# enthalten (/etc/smart-terminal/base.env) und müssen hier NICHT eingetragen werden.
#
# Drucker-IPs werden NICHT hier konfiguriert — sie kommen zur Laufzeit
# aus printers.json auf dem Proxmox-Share.

TERMINAL_ID=3dprint-01
