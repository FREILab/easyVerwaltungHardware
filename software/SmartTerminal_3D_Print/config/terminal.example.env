# Gerätespezifische Konfiguration — lokal nach config/terminal.env kopieren.
TERMINAL_ID=3dprint-01

# Betriebsmodi: "mock" für Entwicklung ohne Hardware/Server, "live"/"pi" für Echtbetrieb
HARDWARE_MODE=mock
PAYMENT_MODE=mock
PRINTER_MODE=mock

# easyVerwaltung Payment-Service (nur für PAYMENT_MODE=live)
EASYVERWALTUNG_URL=http://localhost:8001
EASYVERWALTUNG_SERVICE_ID=svc_inst_001
EASYVERWALTUNG_SERVICE_TOKEN=REPLACE_ME

# Drucker-Konfiguration (lokale Datei oder URL auf Proxmox-Share)
PRINTERS_CONFIG_FILE=/config/printers.dev.json
PRINTERS_CONFIG_URL=
PRINTERS_POLL_INTERVAL_SECONDS=10

# Slicer-Upload Auth (leer = im lokalen Netz ohne Passwort akzeptieren)
SLICER_API_KEY=

# Preis-Absicherung (Cent): G-Code-Preis wird genutzt, aber gegen Untergrenze/Fallback geprüft
DEFAULT_PRICE_PER_GRAM_CENTS=4
MIN_PRICE_PER_GRAM_CENTS=2
MIN_JOB_PRICE_CENTS=10

# Job-Warteschlange
JOB_TTL_SECONDS=300
MAX_UPLOAD_MB=250

# Feature-Flags (für Funktionen, deren easyVerwaltung-Endpunkte noch folgen)
FEATURE_TOPUP=false
FEATURE_APPROVAL=false
ALLOW_NEGATIVE_BALANCE=true
MAX_NEGATIVE_BALANCE_CENTS=2000
