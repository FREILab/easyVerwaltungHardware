	(text "VIAS -- 20 um barrel plating, dT 5 K. \"per via\" is what one via\ncarries. Derate by 0.7 in dense via fields.\n\nVia | Drill  | Pad     | Aspect | per via\n----|--------|---------|--------|---------\nA   | 0.2 mm | 0.45 mm | 8:1    | 0.839 A\nB   | 0.3 mm | 0.6 mm  | 5.3:1  | 1.126 A\nC   | 0.6 mm | 1.0 mm  | 2.7:1  | 1.861 A\nD   | 1.0 mm | 1.4 mm  | 1.6:1  | 2.695 A"
		(exclude_from_sim no)
		(at 191.262 270.51 0)
		(effects
			(font
				(face "PT Mono")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "044588dc-9337-4948-84e5-e0fbddfa9c83")
	)
