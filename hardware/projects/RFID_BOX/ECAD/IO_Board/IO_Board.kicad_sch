	(text "CLEARANCE & CREEPAGE -- I/O BOARD 230V\nMaster table, binding for layout and DRC rules.\nBasis: IEC 60664-1, 250 VAC working voltage, OVC II, pollution degree 2\n       (sealed IP64 enclosure), material group IIIa.\nDesign minima in mm, valid for clearance AND creepage, on both layers.\nL / N = mains poles, ISO = measurement island (at N potential via NT300),\nSELV = everything else, PE = protective earth (basic insulation to mains).\n          |    L     |    N     |   ISO    |   SELV   |    PE\n----------|----------|----------|----------|----------|----------\n  L       |   0.5    |   3.0    |   3.0    |   8.0    |   3.0\n  N       |          |   0.5    |   0.5    |   8.0    |   3.0\n  ISO     |          |          |   0.3    |   8.0    |   3.0\n  SELV    |          |          |          |   0.2    |   0.2\n  PE      |          |          |          |          |    --\n  Exception: inside U300 (ISOW7721DFMR) 0.2 mm. The package provides the\n  barrier; its pads across the barrier are 7.25 mm apart."
		(exclude_from_sim no)
		(at 15.748 262.382 0)
		(effects
			(font
				(face "PT Mono")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8d80f9d8-bd93-471b-9d8c-9cd197f0e8e2")
	)
