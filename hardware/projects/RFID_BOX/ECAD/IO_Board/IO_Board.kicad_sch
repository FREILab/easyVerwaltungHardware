	)
	(text "NET CLASS TRACK WIDTHS -- I/O BOARD 230V\n2 layers, 70 um (2 oz), FR4 1.6 mm. IPC-2221 outer layer, dT = 5 K.\n\nNet class   | I max   | Width  | Via\n------------|---------|--------|------\n230V_ext    | 8.000 A | 4.0 mm | 5x D\nPE          | 8.000 A | 4.0 mm | 5x D\n230V_int    | 0.500 A | 1.0 mm | 1x C\n5V          | 2.000 A | 1.0 mm | 2x C\n24V         | 0.500 A | 0.8 mm | 1x C\n3V3         | 1.000 A | 0.5 mm | 1x C\nISO_signals | 0.020 A | 0.4 mm | 1x A\nSignals     | 0.100 A | 0.3 mm | 1x B"
		(exclude_from_sim no)
		(at 140.716 265.43 0)
		(effects
			(font
				(face "PT Mono")
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2f784883-c3c9-4a00-88ed-b74409f4d8eb")
	)
