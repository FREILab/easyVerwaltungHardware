(version 1)

# >>> JLCPCB Fertigungsgrenzen (apply_jlc_rules.py) >>>
# Quelle: https://jlcpcb.com/capabilities/pcb-capabilities (abgerufen 2026-11-17)
# Standard-FR-4, 1 oz aussen, 1-2 Lagen, ohne Aufpreis.
# Allgemeine Mindestwerte stehen im Board Setup (Constraints).

(rule "JLC: Restring THT-Pad"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

(rule "JLC: PTH-Bohrung zu Kupfer"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC: Pad-Bohrung zu Pad-Bohrung"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC: NPTH-Bohrung"
	(condition "A.Type == 'Pad' && !A.isPlated()")
	(constraint hole_size (min 0.50mm)))

(rule "JLC: Durchkontaktierter Schlitz"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.50mm)))

(rule "JLC: Groesste Bohrung"
	(constraint hole_size (max 6.3mm)))
# <<< JLCPCB Fertigungsgrenzen <<<

# ---------------------------------------------------------------------------
# Clearance & creepage -- I/O Board 230V
# IEC 60664-1, 250 VAC working voltage, OVC II, pollution degree 2,
# material group IIIa. Each value applies to clearance and creepage,
# on both layers. Source: master table in the schematic.
#
# Groups: L, N          mains poles (netclass patterns /PIN_L*, /PIN_N*)
#         ISO_signals   measurement island, at N potential via NT300
#         PE            protective earth
#         SELV          everything else, written as the complement, so an
#                       unassigned net keeps 8 mm from mains instead of
#                       slipping through
#
# Conditions are symmetric, so rule order does not matter -- except for the
# last rule, which must stay last. Later rules win over earlier ones.
# ---------------------------------------------------------------------------

# -- same pole: 0.5 ---------------------------------------------------------
(rule "mains_same_pole"
	(condition "(A.hasNetclass('L') && B.hasNetclass('L')) || (A.hasNetclass('N') && B.hasNetclass('N'))")
	(constraint clearance (min 0.5mm))
	(constraint creepage (min 0.5mm)))

# -- across protective elements: 3.0 ----------------------------------------
#    When R303, F302 or F301 opens, the full mains voltage is across the gap.
#    Both sides keep the opposite-pole distance, pads and tracks alike.
(rule "across_protective_element"
	(condition "(A.NetName == '/PIN_L' && B.NetName == 'Net-(F302-Pad1)') || (A.NetName == 'Net-(F302-Pad1)' && B.NetName == '/PIN_L') || (A.NetName == 'Net-(F302-Pad1)' && B.NetName == '/PIN_L_CTRL_F') || (A.NetName == '/PIN_L_CTRL_F' && B.NetName == 'Net-(F302-Pad1)') || (A.NetName == '/PIN_L' && B.NetName == '/PIN_L_FUSED') || (A.NetName == '/PIN_L_FUSED' && B.NetName == '/PIN_L')")
	(constraint clearance (min 3.0mm))
	(constraint creepage (min 3.0mm)))

# -- opposite poles: 3.0 ----------------------------------------------------
(rule "mains_opposite_poles"
	(condition "(A.hasNetclass('L') && B.hasNetclass('N')) || (A.hasNetclass('N') && B.hasNetclass('L'))")
	(constraint clearance (min 3.0mm))
	(constraint creepage (min 3.0mm)))

# -- resistor chains, middle nodes against the opposite pole: 1.5 -----------
#    BLEEDER_MID = middle nodes of the bleeder chain R300-R302
#    (Net-(R300-Pad2) class L, Net-(R301-Pad2) class N) and of the voltage
#    divider R328-R306-R308 (/PIN_L_DIV_HI, /PIN_L_DIV, class L).
#    A flashover from a middle node is limited by at least one 330k resistor.
#    1.5 mm still meets 2.5 kV clearance and 250 V PCB creepage. Direct L to N
#    and L to island stay at 3.0.
(rule "bleeder_mid_to_opposite_pole"
	(condition "(A.hasNetclass('BLEEDER_MID') && ((A.hasNetclass('L') && B.hasNetclass('N')) || (A.hasNetclass('N') && B.hasNetclass('L')))) || (B.hasNetclass('BLEEDER_MID') && ((B.hasNetclass('L') && A.hasNetclass('N')) || (B.hasNetclass('N') && A.hasNetclass('L'))))")
	(constraint clearance (min 1.5mm))
	(constraint creepage (min 1.5mm)))

# -- island is at N potential: 0.5 to N, 3.0 to L ---------------------------
(rule "island_to_N"
	(condition "(A.hasNetclass('ISO_signals') && B.hasNetclass('N')) || (A.hasNetclass('N') && B.hasNetclass('ISO_signals'))")
	(constraint clearance (min 0.5mm))
	(constraint creepage (min 0.5mm)))

(rule "island_to_L"
	(condition "(A.hasNetclass('ISO_signals') && B.hasNetclass('L')) || (A.hasNetclass('L') && B.hasNetclass('ISO_signals'))")
	(constraint clearance (min 3.0mm))
	(constraint creepage (min 3.0mm)))

# -- L-side middle nodes of the resistor chains against the island: 1.5 -----
#    island is at N potential, same reasoning as bleeder_mid_to_opposite_pole
(rule "bleeder_mid_to_island"
	(condition "(A.hasNetclass('BLEEDER_MID') && A.hasNetclass('L') && B.hasNetclass('ISO_signals')) || (B.hasNetclass('BLEEDER_MID') && B.hasNetclass('L') && A.hasNetclass('ISO_signals'))")
	(constraint clearance (min 1.5mm))
	(constraint creepage (min 1.5mm)))

# -- inside the island: 0.3 -------------------------------------------------
(rule "island_internal"
	(condition "A.hasNetclass('ISO_signals') && B.hasNetclass('ISO_signals')")
	(constraint clearance (min 0.3mm))
	(constraint creepage (min 0.3mm)))

# -- barrier, mains or island against SELV: 8.0 -----------------------------
(rule "barrier_A_mains"
	(condition "(A.hasNetclass('L') || A.hasNetclass('N') || A.hasNetclass('ISO_signals')) && !B.hasNetclass('L') && !B.hasNetclass('N') && !B.hasNetclass('ISO_signals') && !B.hasNetclass('PE')")
	(constraint clearance (min 8.0mm))
	(constraint creepage (min 8.0mm)))

(rule "barrier_B_mains"
	(condition "(B.hasNetclass('L') || B.hasNetclass('N') || B.hasNetclass('ISO_signals')) && !A.hasNetclass('L') && !A.hasNetclass('N') && !A.hasNetclass('ISO_signals') && !A.hasNetclass('PE')")
	(constraint clearance (min 8.0mm))
	(constraint creepage (min 8.0mm)))

# -- PE against mains and island: 3.0 ---------------------------------------
(rule "mains_to_PE"
	(condition "(A.hasNetclass('PE') && (B.hasNetclass('L') || B.hasNetclass('N') || B.hasNetclass('ISO_signals'))) || (B.hasNetclass('PE') && (A.hasNetclass('L') || A.hasNetclass('N') || A.hasNetclass('ISO_signals')))")
	(constraint clearance (min 3.0mm))
	(constraint creepage (min 3.0mm)))

# -- Kupfer ohne Netz auf der Inselseite: U301 Pin 14/16 (NC) und die
#    Kupferflaeche des Net-Ties NT300 zaehlen zur Insel, nicht zu SELV.
(rule "island_nonet_to_SELV"
	(condition "(((A.memberOfFootprint('U301') || A.memberOfFootprint('NT300')) && A.NetName == '') && !B.hasNetclass('L') && !B.hasNetclass('N') && !B.hasNetclass('ISO_signals') && !B.hasNetclass('PE')) || (((B.memberOfFootprint('U301') || B.memberOfFootprint('NT300')) && B.NetName == '') && !A.hasNetclass('L') && !A.hasNetclass('N') && !A.hasNetclass('ISO_signals') && !A.hasNetclass('PE'))")
	(constraint clearance (min 8.0mm))
	(constraint creepage (min 8.0mm)))

(rule "island_nonet_to_L"
	(condition "(((A.memberOfFootprint('U301') || A.memberOfFootprint('NT300')) && A.NetName == '') && B.hasNetclass('L')) || (((B.memberOfFootprint('U301') || B.memberOfFootprint('NT300')) && B.NetName == '') && A.hasNetclass('L'))")
	(constraint clearance (min 3.0mm))
	(constraint creepage (min 3.0mm)))

(rule "island_nonet_to_island"
	(condition "(((A.memberOfFootprint('U301') || A.memberOfFootprint('NT300')) && A.NetName == '') && (B.hasNetclass('ISO_signals') || B.hasNetclass('N') || B.NetName == '')) || (((B.memberOfFootprint('U301') || B.memberOfFootprint('NT300')) && B.NetName == '') && (A.hasNetclass('ISO_signals') || A.hasNetclass('N') || A.NetName == ''))")
	(constraint clearance (min 0.3mm))
	(constraint creepage (min 0.3mm)))

# -- U303 (MCP39F511A, QFN 0,5 mm) auf der Insel: Pad-Abstand gibt das Gehaeuse vor
(rule "island_inside_U303"
	(condition "A.memberOfFootprint('U303') && B.memberOfFootprint('U303')")
	(constraint clearance (min 0.15mm))
	(constraint creepage (min 0.15mm)))

# -- mains copper incl. ISO island: 2.0 mm to board edge, cut-outs and holes
#    (Layoutregeln 3); vias in mains nets at least 0.6 mm drill.
(rule "mains_to_edge"
	(condition "A.hasNetclass('L') || A.hasNetclass('N') || A.hasNetclass('ISO_signals')")
	(constraint edge_clearance (min 2.0mm)))

(rule "mains_via_drill"
	(condition "A.Type == 'Via' && (A.hasNetclass('L') || A.hasNetclass('N'))")
	(constraint hole_size (min 0.6mm)))

# -- U301 (ISOW7721DFMR): the package is the barrier. Its pads across the
#    barrier are 7.25 mm apart (Pad 1 /VIO to Pad 20 +3V3_ISO), below the
#    8.0 mm board value. Both items must belong to U301, so a track crossing
#    the footprint is still checked against 8.0 mm. Must stay last.
(rule "barrier_inside_U301"
	(condition "A.memberOfFootprint('U301') && B.memberOfFootprint('U301')")
	(constraint clearance (min 0.2mm))
	(constraint creepage (min 0.2mm)))