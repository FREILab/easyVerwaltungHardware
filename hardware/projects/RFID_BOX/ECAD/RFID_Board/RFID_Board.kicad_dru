(version 1)

# J400 (GCT USB4105-GF-A): Land-Pattern des Herstellers, NPTH 0,175 mm von den Pads
(rule "J400 NPTH"
	(condition "A.memberOfFootprint('J400') && B.memberOfFootprint('J400')")
	(constraint hole_clearance (min 0.15mm)))

# J400 sitzt an der Platinenkante, die Schirmlaschen reichen bis an die Kante
(rule "J400 Kante"
	(condition "A.memberOfFootprint('J400') || B.memberOfFootprint('J400')")
	(constraint edge_clearance (min 0mm)))
