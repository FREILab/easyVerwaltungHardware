/**
 * @file secret.h
 * @brief Private credentials. Excluded from version control.
 *          server_host and service_token are injected via
 *          platformio.secrets.ini build flags and must not be redefined here.
 */

#ifndef SECRET_H
#define SECRET_H

#define SERVER_HOST    "dashboard.intern"   ///< Auflösbarer Hostname des Servers
#define SERVICE_TOKEN  "YOUR_SERVICE_TOKEN" ///< easyVerwaltung Service-Token

#endif /* SECRET_H */
