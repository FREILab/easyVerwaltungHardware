/**
 * @file secret.h
 * @brief Private credentials and local configuration overrides.
 * @details This file contains sensitive data like WiFi passwords and 
 * authentication tokens. It is excluded from version control to 
 * maintain security.
 * * @note If definitions here overlap with 'settings.h', compiler warnings 
 * may occur unless one side uses guard clauses.
 */

 /**
 * @defgroup RFIDBOX_POC Machine Node PoC (ESP32)
 * @brief Software for the RFID-Box and Power-Switching-Units.
 * @{ 
 */

#ifndef SECRET_H
#define SECRET_H

/**
 * @name Network Credentials
 * @brief Access data for the local infrastructure.
 */
///@{
#define WIFI_SSID     "SSID"             ///< Local WiFi network name
#define WIFI_PASSWORD "password" ///< WPA2 Network password
///@}

/**
 * @name Backend Communication
 * @brief Connection parameters for the management server.
 */
///@{
#define SERVER_IP            "192.168.178.99" ///< Target IP of the auth-server
#define AUTHENTICATION_TOKEN "token" ///< Secure API token
///@}

/**
 * @name Local Overrides
 * @brief Specific machine configuration for this local node.
 * @details Available machine types: "tuer", "lasercutter", "lasercutterXTool", 
 * "3dprinter", "metal-mill", "lathe", "embroiderymachine", "cncmill-wood", 
 * "cncmill-metal", "3dprinter-xl", "panel-saw", "wood-planer", 
 * "wood-bandsaw", "miter-saw", "wood-routertable"
 */
///@{
#define MACHINE_NAME "lasercutterXTool" ///< Defines the machine group for permission checks
#define MACHINE_ID   "lasercutterXTool"   ///< Unique ID used for backend logging
///@}

/**
 * @name OTA Update Credentials
 * @brief Authentication for Over-The-Air firmware updates via ElegantOTA.
 * @details These credentials are used by both the firmware and the PlatformIO
 * OTA uploader. This is the single source of truth for OTA authentication.
 */
///@{
#define OTA_USERNAME "freilab-admin"     ///< OTA interface username
#define OTA_PASSWORD "changeme"          ///< OTA interface password (change this!)
///@}

#endif /* SECRET_H */