 * on your include order in main.cpp.
 */

 /**
 * @defgroup RFIDBOX_POC Machine Node PoC (ESP32)
 * @brief Software for the RFID-Box and Power-Switching-Units.
 * @{ 
 */

#ifndef SECRET_H
#define SECRET_H

/**
 * @name Network Credentials
 * @brief Credentials for local WiFi access.
 */
///@{
#define WIFI_SSID     "Your_SSID_Here"      ///< Service Set Identifier (Network Name)
#define WIFI_PASSWORD "Your_Password_Here"  ///< WiFi Protected Access (WPA2) Key
///@}

/**
 * @name Backend Communication
 * @brief Server address and security tokens for API access.
 */
///@{
#define SERVER_IP            "192.168.178.99" ///< IPv4 address of the central management server
#define AUTHENTICATION_TOKEN "Your_Secure_Token" ///< API token for node-to-server authentication
///@}

/**
 * @name Local Overrides (Optional)
 * @brief These values typically reside in 'settings.h'. 
 * @details If defined here, ensure 'settings.h' uses guard clauses to 
 * avoid "redefined" compiler warnings.
 * * Available Names: "tuer", "lasercutter", "LaserXTool", "3dprinter", 
 * "metal-mill", "lathe", "embroiderymachine", "cncmill-wood", 
 * "cncmill-metal", "3dprinter-xl", "panel-saw", "wood-planer", 
 * "wood-bandsaw", "miter-saw", "wood-routertable"
 */
///@{
#ifndef MACHINE_NAME
  #define MACHINE_NAME "3dprinter" ///< Defines the machine group for permission checks
#endif

#ifndef MACHINE_ID
  #define MACHINE_ID   "Drucker3"   ///< Specific identifier for backend log files
#endif

#ifndef RFIDCARD_AUTH_CONST
  #define RFIDCARD_AUTH_CONST false ///< Presence detection override (Local Test Mode)
#endif
///@}

#endif /* SECRET_H */

/** @} */