/**
 * @file secret.h
 * @brief Private credentials. Excluded from version control.
 *          server_ip and auth_token are injected via
 *          platformio.secrets.ini build flags and must not be redefined here.
 */

#ifndef SECRET_H
#define SECRET_H

#define SERVER_IP "dashboard.intern"  ///< Server-Adresse (IP oder Hostname)
#define AUTHENTICATION_TOKEN "YOUR_AUTH_TOKEN"   ///< Legacy API-Token

#endif /* SECRET_H */
