{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

  "configurePresets": [

    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PICO_BOARD": "pico2_w",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "auth-permanent",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "AUTH_PERMANENT": "ON" }
    },
    {
      "name": "auth-onetime",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "AUTH_PERMANENT": "OFF" }
    },

    {
      "name": "rfidbox-01",
      "displayName": "Laser Cutter (xtool) — rfidbox-01",
      "inherits": "auth-permanent",
      "cacheVariables": {
        "MACHINE_NAME": "lasercutterXTool",
        "MACHINE_ID":   "rfidbox-01",
        "OTA_HOSTNAME": "rfidbox-01"
      }
    },

    {
      "name": "3dprinter-01",
      "displayName": "3D Printer 01 — 3dprinter-01",
      "inherits": "auth-onetime",
      "cacheVariables": {
        "MACHINE_NAME": "3dprinter",
        "MACHINE_ID":   "3dprinter-01",
        "OTA_HOSTNAME": "3dprinter-01"
      }
    },
    {
      "name": "3dprinter-02",
