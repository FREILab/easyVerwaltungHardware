# Copy to env.local.cmake and fill in real values.
# This file is loaded automatically by CMake and should stay out of Git.

set(WIFI_SSID "YOUR_WIFI_SSID")
set(WIFI_PASSWORD "YOUR_WIFI_PASSWORD")
set(SERVER_HOST "YOUR_SERVER_IP_OR_DNS")
set(AUTHENTICATION_TOKEN "YOUR_AUTH_TOKEN")

# Optional per-device identity
set(MACHINE_NAME "machine-node")
set(MACHINE_ID "machine-node-01")
set(OTA_HOSTNAME "machine-node-01")
